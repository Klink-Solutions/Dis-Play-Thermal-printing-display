// ======== receipt.h ========
// receipt.h - draws the weather receipt into a 384-px-wide 1-bit canvas.
// Layout is a port of exportReceiptPng() in designer/app.js.
// Pure drawing code (no WiFi / printer), so it also compiles on a PC for preview.
#include <Adafruit_GFX.h>
#include <Fonts/FreeMonoBold24pt7b.h>
#include <Fonts/FreeSansBold24pt7b.h>
#include <Fonts/FreeSansBold9pt7b.h>
#include <Fonts/FreeSans9pt7b.h>
#include <stdio.h>
#include <string.h>

#define RECEIPT_W 384          // 48 mm printable width at 203 dpi
#define RECEIPT_MAX_H 640      // canvas height; the real height is returned by drawReceipt()

enum WeatherIcon { ICON_CLEAR = 0, ICON_PARTLY, ICON_CLOUDS, ICON_RAIN, ICON_SNOW, ICON_THUNDER, ICON_MIST };

static const char *const ICON_NAMES[] = {"Clear",  "Partly Cloudy", "Clouds", "Rain",
                                         "Snow",   "Thunderstorm",  "Mist"};

struct WeatherData {
  char city[32];
  int cond;            // WeatherIcon
  float temp, high, low, feels;
  int rainPct, humidity;
  float windKmh;
  char windDir[3];
  // next four 3-hour steps
  int fcHour[4];
  int fcCond[4];
  float fcTemp[4];
  int fcRain[4];
};

// Black = 1 (matches ESC/POS raster, where a set bit prints a dot).
#define BLACK 1

// --- small helpers -----------------------------------------------------------------------
static void drawIconScaled(Adafruit_GFX &c, int icon, int x, int y, int scale) {
  for (int row = 0; row < 16; row++) {
    uint16_t bits = (pgm_read_byte(&WEATHER_ICONS[icon][row * 2]) << 8) |
                    pgm_read_byte(&WEATHER_ICONS[icon][row * 2 + 1]);
    for (int col = 0; col < 16; col++)
      if (bits & (0x8000 >> col)) c.fillRect(x + col * scale, y + row * scale, scale, scale, BLACK);
  }
}

static void rule(Adafruit_GFX &c, int y, int thickness = 2) {
  for (int i = 0; i < thickness; i++) c.drawFastHLine(18, y + i, RECEIPT_W - 36, BLACK);
}

static int textWidth(Adafruit_GFX &c, const char *s) {
  int16_t x1, y1;
  uint16_t w, h;
  c.getTextBounds(s, 0, 0, &x1, &y1, &w, &h);
  return (int)w + x1;  // advance incl. left bearing
}

static void textAt(Adafruit_GFX &c, const GFXfont *f, int x, int baseline, const char *s) {
  c.setFont(f);
  c.setTextColor(BLACK);
  c.setCursor(x, baseline);
  c.print(s);
}

static void textCentered(Adafruit_GFX &c, const GFXfont *f, int cx, int baseline, const char *s) {
  c.setFont(f);
  textAt(c, f, cx - textWidth(c, s) / 2, baseline, s);
}

static void textRight(Adafruit_GFX &c, const GFXfont *f, int rx, int baseline, const char *s) {
  c.setFont(f);
  textAt(c, f, rx - textWidth(c, s), baseline, s);
}

// The GFX fonts only contain ASCII, so the degree sign is drawn as a small ring.
// Draws "<value><ring>C" and returns its total width. align: 0 = left at x, 1 = centered on x.
static int drawTemp(Adafruit_GFX &c, const GFXfont *f, int x, int baseline, float v, int align,
                    int ringR) {
  char num[12];
  snprintf(num, sizeof num, "%.1f", v);
  c.setFont(f);
  int wNum = textWidth(c, num);
  int wC = textWidth(c, "C");
  int ringW = ringR * 2 + 4;
  int total = wNum + ringW + wC;
  int x0 = align == 1 ? x - total / 2 : x;
  textAt(c, f, x0, baseline, num);
  // ring sits at the top-right of the digits (cap height ~ ringR * 3.5)
  int capH = (f == &FreeSansBold24pt7b) ? 34 : 13;
  int cy = baseline - capH + ringR + 1;
  int cx = x0 + wNum + 2 + ringR;
  c.drawCircle(cx, cy, ringR, BLACK);
  if (ringR >= 4) c.drawCircle(cx, cy, ringR - 1, BLACK);
  textAt(c, f, x0 + wNum + ringW, baseline, "C");
  return total;
}

static void metric(Adafruit_GFX &c, int cx, int top, const char *label, const char *value) {
  textCentered(c, &FreeSansBold9pt7b, cx, top + 17, label);
  textCentered(c, &FreeSans9pt7b, cx, top + 40, value);
}

// --- the receipt ---------------------------------------------------------------------------
// Returns the number of rows actually used (print only this many).
static int drawReceipt(GFXcanvas1 &c, const WeatherData &w, int hh, int mm, int ss, int dd, int mo,
                       int yyyy) {
  char buf[40];
  c.fillScreen(0);

  // Clock
  snprintf(buf, sizeof buf, "%02d:%02d:%02d", hh, mm, ss);
  textCentered(c, &FreeMonoBold24pt7b, RECEIPT_W / 2, 58, buf);

  // Location + date
  textAt(c, &FreeSansBold9pt7b, 18, 90, w.city);
  snprintf(buf, sizeof buf, "%02d.%02d.%04d", dd, mo, yyyy);
  textRight(c, &FreeSans9pt7b, 366, 90, buf);
  rule(c, 105);

  // Current conditions: big icon + temperature + high/low
  drawIconScaled(c, w.cond, 20, 118, 8);
  drawTemp(c, &FreeSansBold24pt7b, 160, 176, w.temp, 0, 5);
  textAt(c, &FreeSans9pt7b, 162, 200, ICON_NAMES[w.cond]);
  textAt(c, &FreeSansBold9pt7b, 162, 226, "HIGH");
  textAt(c, &FreeSansBold9pt7b, 263, 226, "LOW");
  drawTemp(c, &FreeSans9pt7b, 162, 246, w.high, 0, 3);
  drawTemp(c, &FreeSans9pt7b, 263, 246, w.low, 0, 3);
  rule(c, 262);

  // Details, 2 x 2 grid
  int top1 = 270, top2 = 322;
  int cxL = 18 + (RECEIPT_W - 36) / 4, cxR = 18 + 3 * (RECEIPT_W - 36) / 4;
  textCentered(c, &FreeSansBold9pt7b, cxL, top1 + 17, "Feels like");
  drawTemp(c, &FreeSans9pt7b, cxL, top1 + 40, w.feels, 1, 3);
  snprintf(buf, sizeof buf, "%d%%", w.rainPct);
  metric(c, cxR, top1, "Rain", buf);
  snprintf(buf, sizeof buf, "%d%%", w.humidity);
  metric(c, cxL, top2, "Humidity", buf);
  snprintf(buf, sizeof buf, "%.1f km/h %s", w.windKmh, w.windDir);
  metric(c, cxR, top2, "Wind", buf);
  rule(c, 376);

  // Forecast
  textAt(c, &FreeSansBold9pt7b, 18, 402, "NEXT 12 HOURS - 3H STEPS");
  int y = 412;
  for (int i = 0; i < 4; i++) {
    c.drawFastHLine(18, y, RECEIPT_W - 36, BLACK);  // thin separator
    snprintf(buf, sizeof buf, "%02d:00", w.fcHour[i]);
    textAt(c, &FreeSansBold9pt7b, 24, y + 27, buf);
    drawIconScaled(c, w.fcCond[i], 96, y + 4, 2);
    drawTemp(c, &FreeSans9pt7b, 220, y + 27, w.fcTemp[i], 1, 3);
    snprintf(buf, sizeof buf, "%d%%", w.fcRain[i]);
    textCentered(c, &FreeSans9pt7b, 320, y + 27, buf);
    y += 40;
  }
  c.drawFastHLine(18, y, RECEIPT_W - 36, BLACK);
  return y + 2;  // footer banner removed for now
}

// ======== escpos.h ========
// escpos.h - minimal ESC/POS driver for the thermal printer (TTL serial, 9600 8N1 by default).
// Commands are taken from the CSN-A2 manual (references/printer-notes.md). Verify on your own unit.
#include <Arduino.h>

// ESC @ : reset printer to defaults. Send once at startup and before each job.
static void escposInit(Print &p) {
  const uint8_t cmd[] = {0x1B, 0x40};
  p.write(cmd, sizeof cmd);
}

// ESC 7 n1 n2 n3 : heating parameters (manual p.48).
//   n1 = max dots heated at once is 8*(n1+1); lower = lower peak current, slower dark areas
//   n2 = heating time (x10 us), n3 = heating interval (x10 us)
static void escposHeating(Print &p, uint8_t n1, uint8_t n2, uint8_t n3) {
  const uint8_t cmd[] = {0x1B, 0x37, n1, n2, n3};
  p.write(cmd, sizeof cmd);
}

// DC2 # n : print density. Low 5 bits = density (0..31), high 3 bits = break time.
static void escposDensity(Print &p, uint8_t n) {
  const uint8_t cmd[] = {0x12, 0x23, n};
  p.write(cmd, sizeof cmd);
}

// ESC d n : print buffer and feed n lines.
static void escposFeed(Print &p, uint8_t lines) {
  const uint8_t cmd[] = {0x1B, 0x64, lines};
  p.write(cmd, sizeof cmd);
}

// GS v 0 : print a raster bitmap, sent in horizontal bands.
//   buf        1 bit per pixel, MSB = leftmost pixel, 1 = black (same layout as GFXcanvas1)
//   widthBytes bytes per row (384 px = 48)
//   rows       number of rows to print
//   bandRows   rows per GS v 0 command (24..64 is a good range)
//   bandDelay  ms to wait after each band so the printer can keep up
static void escposRaster(Print &p, const uint8_t *buf, int widthBytes, int rows, int bandRows,
                         int bandDelayMs) {
  for (int y = 0; y < rows; y += bandRows) {
    int n = min(bandRows, rows - y);
    const uint8_t hdr[] = {0x1D, 0x76, 0x30, 0x00,
                           (uint8_t)(widthBytes & 0xFF), (uint8_t)(widthBytes >> 8),
                           (uint8_t)(n & 0xFF),          (uint8_t)(n >> 8)};
    p.write(hdr, sizeof hdr);
    p.write(buf + (size_t)y * widthBytes, (size_t)n * widthBytes);
    p.flush();
    if (bandDelayMs > 0) delay(bandDelayMs);
  }
}

// ======== main sketch ========
static GFXcanvas1 *canvasPtr = nullptr;  // ~31 KB, allocated in setup()
#define canvas (*canvasPtr)
static unsigned long lastAutoPrint = 0;
static bool lastButton = true;

// ---- status LED -----------------------------------------------------------------------------
enum LedState { LED_OFF, LED_BOOT, LED_BUSY, LED_OK, LED_ERROR };
static void led(LedState s) {
  uint8_t r = 0, g = 0, b = 0;
  switch (s) {
    case LED_BOOT:  b = NEO_BRIGHTNESS; break;                       // blue   : connecting
    case LED_BUSY:  r = NEO_BRIGHTNESS; g = NEO_BRIGHTNESS / 2; break; // amber  : fetching/printing
    case LED_OK:    g = NEO_BRIGHTNESS; break;                       // green  : ready / done
    case LED_ERROR: r = NEO_BRIGHTNESS; break;                       // red    : failed
    default: break;
  }
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  rgbLedWrite(LED_PIN, r, g, b);
#else
  neopixelWrite(LED_PIN, r, g, b);
#endif
}

// ---- weather ---------------------------------------------------------------------------------
static int iconForWmo(int code) {  // WMO weather code -> icon
  if (code <= 1) return ICON_CLEAR;
  if (code == 2) return ICON_PARTLY;
  if (code == 3) return ICON_CLOUDS;
  if (code == 45 || code == 48) return ICON_MIST;
  if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return ICON_RAIN;
  if ((code >= 71 && code <= 77) || code == 85 || code == 86) return ICON_SNOW;
  if (code >= 95) return ICON_THUNDER;
  return ICON_CLOUDS;
}

static void compassFromDegrees(float deg, char out[3]) {
  static const char *const names[] = {"N", "NE", "E", "SE", "S", "SW", "W", "NW"};
  strcpy(out, names[((int)((deg + 22.5f) / 45.0f)) % 8]);
}

static bool fetchWeather(WeatherData &w, int hourNow) {
  char url[420];
  snprintf(url, sizeof url,
           "https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f"
           "&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,"
           "wind_speed_10m,wind_direction_10m"
           "&hourly=temperature_2m,precipitation_probability,weather_code"
           "&daily=temperature_2m_max,temperature_2m_min"
           "&timezone=%s&forecast_days=2",
           LATITUDE, LONGITUDE, TIMEZONE_NAME);

  WiFiClientSecure client;
  client.setInsecure();  // PROTOTYPE ONLY: skips certificate checks. Pin a CA bundle before shipping.
  HTTPClient http;
  http.setTimeout(15000);
  http.useHTTP10(true);  // avoids chunked encoding so the JSON stream parses cleanly
  if (!http.begin(client, url)) return false;
  int status = http.GET();
  if (status != 200) {
    Serial.printf("weather HTTP %d\n", status);
    http.end();
    return false;
  }

  JsonDocument filter;
  filter["current"] = true;
  filter["hourly"]["temperature_2m"] = true;
  filter["hourly"]["precipitation_probability"] = true;
  filter["hourly"]["weather_code"] = true;
  filter["daily"]["temperature_2m_max"] = true;
  filter["daily"]["temperature_2m_min"] = true;
  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, http.getStream(), DeserializationOption::Filter(filter));
  http.end();
  if (err) {
    Serial.printf("weather JSON: %s\n", err.c_str());
    return false;
  }

  memset(&w, 0, sizeof w);
  strlcpy(w.city, CITY_NAME, sizeof w.city);
  JsonObject cur = doc["current"];
  w.temp = cur["temperature_2m"];
  w.feels = cur["apparent_temperature"];
  w.humidity = cur["relative_humidity_2m"];
  w.windKmh = cur["wind_speed_10m"];
  compassFromDegrees(cur["wind_direction_10m"] | 0.0f, w.windDir);
  w.cond = iconForWmo(cur["weather_code"] | 3);
  w.high = doc["daily"]["temperature_2m_max"][0];
  w.low = doc["daily"]["temperature_2m_min"][0];
  w.rainPct = doc["hourly"]["precipitation_probability"][hourNow] | 0;
  for (int i = 0; i < 4; i++) {
    int idx = hourNow + 3 * (i + 1);  // hourly arrays start at 00:00 today and cover 48 h
    w.fcHour[i] = idx % 24;
    w.fcTemp[i] = doc["hourly"]["temperature_2m"][idx];
    w.fcRain[i] = doc["hourly"]["precipitation_probability"][idx] | 0;
    w.fcCond[i] = iconForWmo(doc["hourly"]["weather_code"][idx] | 3);
  }
  return true;
}

// ---- wifi + clock ------------------------------------------------------------------------------
static bool connectWifi() {
  if (WiFi.status() == WL_CONNECTED) return true;
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  for (int i = 0; i < 60 && WiFi.status() != WL_CONNECTED; i++) delay(250);
  return WiFi.status() == WL_CONNECTED;
}

static bool syncClock() {
  configTzTime(TZ_POSIX, "pool.ntp.org", "time.google.com");
  struct tm t;
  return getLocalTime(&t, 10000);
}

// ---- printing ----------------------------------------------------------------------------------
static void printerSetup() {
  Serial1.begin(PRINTER_BAUD, SERIAL_8N1, PRINTER_RX_PIN, PRINTER_TX_PIN);
  delay(300);
  escposInit(Serial1);
  escposHeating(Serial1, HEAT_N1, 80, 2);
  escposDensity(Serial1, DENSITY);
}

static void printWeatherReceipt() {
  led(LED_BUSY);
  if (!connectWifi()) { Serial.println("WiFi failed"); led(LED_ERROR); return; }
  struct tm t;
  if (!getLocalTime(&t, 2000)) { Serial.println("no time"); led(LED_ERROR); return; }
  WeatherData w;
  if (!fetchWeather(w, t.tm_hour)) { led(LED_ERROR); return; }
  getLocalTime(&t, 2000);  // refresh seconds after the network round trip
  int rows = drawReceipt(canvas, w, t.tm_hour, t.tm_min, t.tm_sec, t.tm_mday, t.tm_mon + 1,
                         t.tm_year + 1900);
  Serial.printf("printing %d rows (%d bytes)\n", rows, rows * (RECEIPT_W / 8));
  escposInit(Serial1);
  escposHeating(Serial1, HEAT_N1, 80, 2);
  escposDensity(Serial1, DENSITY);
  escposRaster(Serial1, canvas.getBuffer(), RECEIPT_W / 8, rows, BAND_ROWS, BAND_DELAY_MS);
  escposFeed(Serial1, FEED_LINES);
  Serial1.flush();
  led(LED_OK);
}

// Hardware smoke test: a plain text line, then a striped bitmap. No WiFi needed.
static void printTestStrip() {
  escposInit(Serial1);
  Serial1.println("PRINTER TEST");
  canvas.fillScreen(0);
  for (int x = 0; x < RECEIPT_W; x += 16) canvas.fillRect(x, 0, 8, 40, 1);
  canvas.drawRect(0, 0, RECEIPT_W, 40, 1);
  escposRaster(Serial1, canvas.getBuffer(), RECEIPT_W / 8, 40, BAND_ROWS, BAND_DELAY_MS);
  escposFeed(Serial1, FEED_LINES);
}

// ---- Arduino entry points ------------------------------------------------------------------------
void setup() {
  Serial.begin(115200);
  delay(500);
  canvasPtr = new GFXcanvas1(RECEIPT_W, RECEIPT_MAX_H);
  led(LED_BOOT);
  printerSetup();
  if (BUTTON_PIN >= 0) pinMode(BUTTON_PIN, INPUT_PULLUP);

  if (!connectWifi()) { Serial.println("WiFi failed - check config.h"); led(LED_ERROR); return; }
  if (!syncClock()) { Serial.println("NTP failed"); led(LED_ERROR); return; }
  Serial.println("ready: 'p' = print weather, 's' = test strip");
  led(LED_OK);
  if (PRINT_ON_BOOT) printWeatherReceipt();
  lastAutoPrint = millis();
}

void loop() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == 'p') printWeatherReceipt();
    if (ch == 's') printTestStrip();
  }
  if (BUTTON_PIN >= 0) {
    bool pressed = digitalRead(BUTTON_PIN) == LOW;
    if (pressed && lastButton) { delay(30); if (digitalRead(BUTTON_PIN) == LOW) printWeatherReceipt(); }
    lastButton = !pressed;
  }
  if (PRINT_INTERVAL_MIN > 0 && millis() - lastAutoPrint > (unsigned long)PRINT_INTERVAL_MIN * 60000UL) {
    lastAutoPrint = millis();
    printWeatherReceipt();
  }
  delay(20);
}
